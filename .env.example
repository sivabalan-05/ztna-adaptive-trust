# --- Application ------------------------------------------------------------
APP_NAME=AI-Based Zero Trust Network Access
APP_ENV=development
DEBUG=true
TZ=Asia/Kolkata
API_PORT=8000
WEB_PORT=5173

# --- Security ---------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_64_byte_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER=ZTNA Platform

# --- Database ---------------------------------------------------------------
# Docker Compose overrides DATABASE_URL with the Postgres service URL.
# Left as sqlite, the app runs with no Docker and no Postgres installed.
POSTGRES_USER=ztna
POSTGRES_PASSWORD=ztna_dev_password
POSTGRES_DB=ztna
POSTGRES_PORT=5432
# DATABASE_URL=postgresql+psycopg://ztna:ztna_dev_password@localhost:5432/ztna
# Unset => SQLite at <project root>/ztna.db (absolute, cwd-independent).
# DATABASE_URL=sqlite:///./ztna.db

# --- Cache / session store --------------------------------------------------
# Unset => in-process fallback store (works offline, single node).
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# --- Trust scoring weights (must total 100) ---------------------------------
TRUST_WEIGHT_IDENTITY=25
TRUST_WEIGHT_DEVICE=20
TRUST_WEIGHT_NETWORK=20
TRUST_WEIGHT_BEHAVIOR=20
TRUST_WEIGHT_LOCATION=10
TRUST_WEIGHT_TEMPORAL=5

# --- Risk band thresholds (lower bound of each band) ------------------------
RISK_LOW_MIN=80
RISK_MEDIUM_MIN=60
RISK_HIGH_MIN=40

# --- Continuous verification ------------------------------------------------
CONTINUOUS_VERIFICATION_INTERVAL_SECONDS=30
SESSION_IDLE_TIMEOUT_MINUTES=30
IMPOSSIBLE_TRAVEL_KMH=900
MAX_FAILED_LOGINS=5
ACCOUNT_LOCKOUT_MINUTES=15

# --- AI models --------------------------------------------------------------
# Unset => <project root>/models (absolute, so the API and the training
# script agree regardless of which directory each was started from).
# MODEL_DIR=./models
ISOLATION_FOREST_CONTAMINATION=0.05
ISOLATION_FOREST_ESTIMATORS=200
ISOLATION_FOREST_RANDOM_STATE=42
PER_USER_MODEL_MIN_EVENTS=50
# Per-user models are trained and measured but not used for enforcement:
# on the seeded corpus they score worse than the global model.
USE_PER_USER_MODELS=false

# --- External services (all optional -- mocks used when absent) -------------
# Unset => <project root>/data/GeoLite2-City.mmdb (absolute, same reason).
# GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
ABUSEIPDB_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ztna-alerts@example.com

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
